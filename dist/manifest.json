{
  "manifest_version": 3,
  "name": "awconnect",
  "short_name": "awconnect",
  "version": "4.1.7",
  "description": "Aitherium in your browser: chat with your workspace agents or your local awdk daemon, with the current page as context.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open awconnect",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Open the awconnect side panel"
    },
    "send-selection": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "Send the selected text to awconnect Chat"
    },
    "toggle-overlay": {
      "suggested_key": {
        "default": "Alt+O"
      },
      "description": "Show AitherOS on this page (again: switch between using the OS and the page)"
    }
  },
  "omnibox": {
    "keyword": "ai"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.aitherium.com/*",
        "https://api.aitherium.com/*",
        "https://idp.aitherium.com/*",
        "https://desktop.aitherium.com/*",
        "https://weights.aitherium.com/*"
      ],
      "js": [
        "content/portal-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "identity",
    "contextMenus",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://www.aitherium.com/*",
    "https://api.aitherium.com/*",
    "https://idp.aitherium.com/*",
    "https://desktop.aitherium.com/*",
    "https://weights.aitherium.com/*",
    "https://mcp.aitherium.com/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "*://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
