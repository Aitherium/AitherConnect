{
  "manifest_version": 3,
  "name": "awconnect — AI Chat & Knowledge Assistant",
  "version": "3.6.4",
  "description": "AI browsing assistant with a local knowledge base. Bring your own API key (Anthropic, OpenAI, OpenRouter, Gemini, Ollama) — chat, save and search what you read.",
  "minimum_chrome_version": "124",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "tabs",
    "scripting",
    "cookies",
    "omnibox",
    "contextMenus",
    "notifications",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "http://localhost/*",
    "https://localhost/*",
    "https://*.aitherium.com/*",
    "https://www.regulations.gov/*"
  ],
  "optional_host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://*.slack.com/*",
    "https://*.atlassian.net/*",
    "https://github.com/*",
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://*.hf.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [ "https://www.regulations.gov/*" ],
      "js": [ "content/cta-engine.js" ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.aitherium.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [ "content/portal-bridge.js" ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["adapters/*.json"],
      "matches": ["https://www.regulations.gov/*", "https://*.aitherium.com/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "awconnect@aitherium.com",
      "strict_min_version": "121.0"
    }
  },
  "externally_connectable": {
    "matches": [
      "https://portal.aitherium.com/*",
      "https://*.aitherium.com/*"
    ]
  },
  "action": {
    "default_title": "Awconnect",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "omnibox": {
    "keyword": "ai"
  },
  "commands": {
    "analyze-selection": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "Analyze selected text with AitherOS"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Open Awconnect"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
